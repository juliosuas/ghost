# Ghost local case-file configuration
# Copy this file to .env and fill in values you actually use.
# CLI-only self-audit (`ghost investigate --authorized --no-ai`) does not
# start Flask and does not require the three GHOST_* vars below.
# `ghost doctor` FAILS (exit 1) until they are set securely — that is an
# exposure gate, not a CLI blocker.

# === SERVER EXPOSURE (locked env names; Flask auth/bind land later) ===

# Flask session/signing key. Doctor fails if this is missing or equals
# the insecure code default `ghost-dev-key` / an example placeholder.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GHOST_SECRET_KEY=

# Bind address for Flask. Doctor fails if set to anything other than
# 127.0.0.1 or localhost. Leave unset for CLI-only (doctor treats unset as OK).
# Do not start the API on 0.0.0.0 until bind/CORS/auth are locked.
GHOST_HOST=127.0.0.1

# API readiness token. Doctor fails when empty. Flask does not enforce this
# yet (token auth lands in a follow-up) — set it before considering the API ready.
GHOST_API_TOKEN=

GHOST_PORT=5000
GHOST_DEBUG=false

# === OPTIONAL AI ===
# Not required for --no-ai / heuristic summaries. Needed for LLM correlation.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# === OPTIONAL — Enhance capabilities ===

# Have I Been Pwned (breach checks)
HIBP_API_KEY=

# Shodan (network intelligence)
SHODAN_API_KEY=

# Google Custom Search (reverse image search, web search)
GOOGLE_API_KEY=
GOOGLE_CX=

# Twitter/X API
TWITTER_BEARER_TOKEN=

# IP Geolocation
IPINFO_TOKEN=

# Hunter.io (email discovery)
HUNTER_API_KEY=

# FullContact (identity resolution)
FULLCONTACT_API_KEY=

# === DATABASE ===
# SQLite is the supported v2 backend. Relative paths resolve under ghost/data/.
DATABASE_URL=sqlite:///ghost.db

# === RATE LIMITING ===
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_PERIOD=60
