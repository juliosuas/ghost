# Ghost OSINT Platform Configuration
# Copy this file to .env and fill in your API keys

# === OPTIONAL AI ===
# Not required for --no-ai / heuristic summaries. Needed for LLM correlation.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# === OPTIONAL — Enhance capabilities ===

# Have I Been Pwned (breach checks)
HIBP_API_KEY=

# Shodan (network intelligence)
SHODAN_API_KEY=

# Google Custom Search (reverse image search, web search)
GOOGLE_API_KEY=
GOOGLE_CX=

# Twitter/X API
TWITTER_BEARER_TOKEN=

# IP Geolocation
IPINFO_TOKEN=

# Hunter.io (email discovery)
HUNTER_API_KEY=

# FullContact (identity resolution)
FULLCONTACT_API_KEY=

# === SERVER CONFIG ===
# Bind loopback by default. Do not set 0.0.0.0 unless you intend to expose the
# Flask process on other interfaces. docker-compose overrides this inside the
# container so published host ports can reach the app.
GHOST_HOST=127.0.0.1
GHOST_PORT=5000
GHOST_DEBUG=false
# Required outside debug. Must not be ghost-dev-key or another placeholder.
GHOST_SECRET_KEY=
# Required when running the Flask API. Send as Authorization: Bearer <token>
# or X-Ghost-Token: <token>.
GHOST_API_TOKEN=

# === DATABASE ===
# SQLite is the supported v2 backend. Relative paths resolve under ghost/data/.
DATABASE_URL=sqlite:///ghost.db

# === RATE LIMITING ===
# Enforced in-memory on /api/* (except /api/health).
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_PERIOD=60
